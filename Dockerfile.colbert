# ColBERT Embeddings Service Dockerfile
FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements for ColBERT service
COPY requirements.colbert.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.colbert.txt

# Copy the ColBERT service
COPY colbert_service.py /app/

# Create cache directory for model
RUN mkdir -p /app/model_cache

# Expose port
EXPOSE 8002

# Environment variables
ENV PYTHONUNBUFFERED=1
ENV COLBERT_MODEL=colbert-ir/colbertv2.0
ENV TRANSFORMERS_CACHE=/app/model_cache
ENV HF_HOME=/app/model_cache

# Run the service
CMD ["python", "-m", "uvicorn", "colbert_service:app", "--host", "0.0.0.0", "--port", "8002"]
